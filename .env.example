# Variaveis deste projeto na Vercel. Nenhuma delas vai para o BI.

# A mesma URL do projeto Supabase do BI.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase -> Settings -> API -> service_role.
# Esta chave ignora o RLS: e o banco inteiro numa string. So aqui, nunca no BI
# e nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# O codigo que a equipe digita para abrir o formulario. Sem ele o formulario
# responde 500 de proposito: e uma URL publica.
CADASTRO_SENHA=
