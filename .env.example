# Variaveis deste projeto na Vercel. Nenhuma delas vai para o BI.

# A mesma URL do projeto Supabase do BI.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase -> Settings -> API Keys -> secret key (sb_secret_...).
# Esta chave ignora o RLS: e o banco inteiro numa string. So aqui, nunca no BI
# e nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Assina o cookie de login dos tipsters. Texto aleatorio com 32+ caracteres;
# gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar este valor desloga todo mundo.
SESSAO_SEGREDO=
